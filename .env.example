# Kopioi tiedostoksi .env.local paikalliseen kehitykseen. Älä koskaan commitoi oikeita arvoja.
# Tuotannossa arvot asetetaan Vercelin ympäristömuuttujiin (Asetukset > Ympäristömuuttujat).

# Sivuston julkinen osoite (ilman loppukauttaviivaa)
NEXT_PUBLIC_SITE_URL=https://www.gfc.fi

# Liidit: Supabase (EU), GFC:n oma projekti. Vercelin Supabase-integraatio lisää nämä itse.
# Taulu: supabase/migrations/20261118_liidit.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Valinnainen sähköposti-ilmoitus uudesta liidistä (esim. Apps Script -webhook)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Google Analytics 4 (GFC verkkosivusto). Ladataan vain evästesuostumuksen jälkeen.
NEXT_PUBLIC_GA_ID=G-DST7EM80BB
